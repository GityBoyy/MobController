{
  "schemaVersion": 1,
  "id": "mobcontroller",
  "version": "${mod_version}",
  "name": "MobController",
  "description": "${mod_desc}",
  "authors": [
    "Small_Chubby"
  ],
  "contact": {
    "homepage": ""
  },
  "license": "MIT",
  "icon": "assets/mobcontroller/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "org.chubby.github.mobcontroller.fabric.MobcontrollerFabric"
    ],
    "fabric-datagen": [
      "org.chubby.github.mobcontroller.fabric.MobControllerFabricDatagen"
    ],
    "client": [
      "org.chubby.github.mobcontroller.fabric.client.MobcontrollerFabricClient"
    ],
    "jei_mod_plugin": [
      "org.chubby.github.mobcontroller.compat.jei.ModJeiPlugin"
    ]
  },
  "mixins": [
    "mobcontroller.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.7",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "fabric-api": "*"
  },
  "suggests": {
    "another-mod": "*"
  }
}
